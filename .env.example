APP_NAME=ETTS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etts
DB_USERNAME=root
DB_PASSWORD=

# Legacy ETTS database (esd_casts_* tables), read only by etts:import-legacy. Never written to.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=etts_legacy
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Private folder for applicant attachments (default storage/app/private/attachments).
ATTACHMENTS_ROOT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sign-in from the IMIS portal. URL of IMIS POST /api/v1/sso/validate; the
# audience defaults to APP_URL host[:port] and must be in IMIS SSO_HUB_HOSTS.
IMIS_SSO_URL=http://localhost:8000/api/v1/sso/validate
IMIS_SSO_AUDIENCE=
# Where people who reach ETTS signed out are sent to open it from IMIS.
IMIS_PORTAL_URL=http://localhost:8000
# Key IMIS sends to /api/imis/summary (Executive Dashboard feed). Unset = the feed is off.
IMIS_FEED_KEY=
# Name suggestions for the routing slip addressee/signatory. The key is IMIS's ETTS_API_TOKEN; the URL
# defaults to IMIS_PORTAL_URL + /api/v1/etts/employees. Unset = no suggestions (free text still works).
IMIS_DIRECTORY_KEY=
IMIS_DIRECTORY_URL=
# Where the header's app switcher sends ESD staff (ONSA, ENLOOKUP, COMEXAMS ...): the ERIS ESD base URL.
ETTS_ERIS_URL=https://imis.cscro8.com/eris/esd


# Public kiosks. Leave ETTS_KIOSK_DOMAINS empty to serve the kiosk under /kiosk.
# In production list the kiosk host(s), e.g. kiosk.cscro8.com; those hosts then serve only the kiosk.
ETTS_KIOSK_DOMAINS=
# Set when behind Cloudflare / a proxy so HTTPS and client IPs are read correctly ("*" or a comma list).
TRUSTED_PROXIES=

# IMIS database, read only by etts:eris-access-plan (a dry-run of who should get ETTS access). Never written to.
IMIS_DB_HOST=127.0.0.1
IMIS_DB_PORT=3306
IMIS_DB_DATABASE=
IMIS_DB_USERNAME=root
IMIS_DB_PASSWORD=
